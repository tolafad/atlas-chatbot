# Copy to .env and fill in. Never commit .env.

# --- Bedrock chatbot (app.py) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-6-v1
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.7

# --- Local runs: named profile from ~/.aws/config (leave unset on EC2; the role is used) ---
AWS_PROFILE=

# --- Deploy scripts (deploy/README.md); not read by the app ---
AWS_ACCOUNT_ID=
